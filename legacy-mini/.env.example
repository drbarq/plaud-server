# Supabase project hosting the `plaud` schema
# thefullpicture project (schema: plaud)
SUPABASE_URL=https://szsnocakbnrfoaauiqkr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Where original MP3s are archived on the mini (device deletes its copies —
# this becomes your only non-Plaud copy)
ARCHIVE_DIR=~/PlaudArchive

# Ignore accidental pocket-taps shorter than this
MIN_DURATION_MS=4000

# STT engine: deepgram = Nova-3 API, ~zero RAM (recommended for the 16GB mini)
# | parakeet | whisper | auto. Everything is transcribed with this engine —
# ~$0.0043/min, so even 1000 min/month is ~$4.30.
STT_ENGINE=deepgram
DEEPGRAM_API_KEY=

# Set true to use Plaud's free-tier transcripts when they exist instead of
# re-transcribing (cheaper by pennies, but inconsistent format/quality)
USE_PLAUD_TRANSCRIPTS=false
