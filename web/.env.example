# ——— Threads PWA env template ———
# Copy to web/.env.local and fill in. Never commit .env.local.

# Public (safe in client):
NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # dashboard → Settings → API → anon/publishable key

# Server-only:
DATABASE_URL=                        # dashboard → Connect → Transaction pooler URI (port 6543)
SUPABASE_SERVICE_ROLE_KEY=           # dashboard → Settings → API → service_role
PLAUD_SYNC_SECRET=                   # must equal the edge-function secret (Vault plaud_sync_secret)
ALLOWED_EMAIL=                       # the one email allowed to sign in
